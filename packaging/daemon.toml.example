# Control-OFC Daemon — admin-owned configuration.
# Copy to /etc/control-ofc/daemon.toml and edit as needed.
# All fields are optional — defaults are shown below.
#
# NOTE: several settings below are admin-owned BASE defaults that the API may
# later OVERRIDE. When a POST /config/* call mutates one of them, the daemon
# writes /var/lib/control-ofc/runtime.toml, whose keys OVERLAY these defaults
# (runtime wins, ADR-002). The two files coexist; this file is admin-owned and
# is never rewritten by the daemon at runtime.
#
# Keys that can be shadowed this way, and by which route:
#   [profiles] search_dirs            POST /config/profile-search-dirs
#   [startup]  delay_secs             POST /config/startup-delay
#   [polling]  poll_interval_ms       POST /config/poll-interval      (250-2000)
#   [serial]   port                   POST /config/serial-port
#   [serial]   timeout_ms             POST /config/serial-timeout     (50-1000)
#   [detection] allow_port_probe      POST /config/allow-port-probe
#   [detection] enable_nvidia_telemetry  POST /config/nvidia-telemetry
#
# The API's bounds on the two interval keys are deliberately TIGHTER than what
# this file accepts: they bound how stale a temperature the 105 C thermal rule
# can act on, and the API is reachable by any local user while this file is not.
#
# If an edit here appears not to take effect, a runtime override is shadowing it:
# GET /config reports source="runtime" for that key, and the daemon logs it once
# at startup. See docs/ADRs/002-runtime-config-split.md.

[serial]
# Use stable /dev/serial/by-id/ path (survives USB re-enumeration)
# port = "/dev/serial/by-id/usb-Karanovic_Research_OpenFan_...-if00"
# timeout_ms = 500

[polling]
# poll_interval_ms = 1000

[ipc]
# socket_path = "/run/control-ofc/control-ofc.sock"

[state]
# state_dir = "/var/lib/control-ofc"

[startup]
# Seconds to wait before device detection at boot (0–30). The API
# (POST /config/startup-delay) can override this at runtime.
# delay_secs = 0
#
# Record a short lifecycle session automatically at daemon start, so a cooler's
# power-on behaviour is captured without somebody sitting at the machine
# (DEC-335). Writes no hardware, takes no lease, and never blocks you: starting
# a session yourself takes the slot immediately and the partial recording is
# still saved. Default: false.
#
# This key belongs HERE and is NOT settable in runtime.toml — that file's
# [startup] section accepts delay_secs alone, under deny_unknown_fields, so an
# unknown key there fails the parse and the WHOLE file falls back to defaults
# (taking your saved header_roles pump assignments with it). There is no
# POST /config/* route for this one.
# record_startup = false

[detection]
# Opt-in active Super-I/O port probe (DEC-203). Default: false.
# When true AND the CAP_SYS_RAWIO systemd drop-in is installed (see
# /usr/share/doc/control-ofc-daemon/superio-port-probe.conf.example), the
# daemon will, on a deliberate POST /inventory/superio/probe, read the
# Super-I/O config ports (0x2E/0x4E) to identify an UNBOUND motherboard chip.
# It never touches a port owned by a bound driver or ACPI. Leave false unless
# you specifically need it — the passive detection covers the common cases,
# and CAP_SYS_RAWIO is effectively root-equivalent.
# allow_port_probe = false
#
# Opt-in READ-ONLY NVIDIA telemetry via NVML (DEC-204). Default: false. When
# true AND the /dev/nvidia* systemd drop-in is installed (see
# /usr/share/doc/control-ofc-daemon/nvidia-telemetry.conf.example), the daemon
# reads NVIDIA GPU temperature + fan telemetry through libnvidia-ml.so.1. It
# NEVER writes to the GPU. EXPERIMENTAL — the NVML path is unverified on
# hardware. The open nouveau driver is read via hwmon and needs neither this
# flag nor the drop-in.
# enable_nvidia_telemetry = false
