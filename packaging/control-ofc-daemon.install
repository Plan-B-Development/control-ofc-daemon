post_install() {
    cat <<'EOF'
:: control-ofc-daemon installed.

   Start now:        sudo systemctl enable --now control-ofc-daemon
   Load modules:     sudo systemctl start systemd-modules-load   (or reboot)
   Setup guide:      man control-ofc-daemon
   Hardware check:   open the GUI -> Hardware page

   System tray:      this package also installs control-ofc-tray, a small
                     StatusNotifierItem client for KDE Plasma. It starts at
                     your next login and gives you profile switching and the
                     running daemon version from the panel. It only starts
                     where control-ofc-gui is installed, and it is purely a
                     convenience -- fan control never depends on it.
                     Disable it in System Settings -> Autostart.
                     Details: man control-ofc-tray

   Fan-control prerequisites — if a motherboard header or GPU fan is
   discovered but never responds, one of these is usually missing:
     * Super I/O driver: motherboard headers need the matching chip driver
                         (e.g. it87-dkms-git / nct6687d-dkms-git — see the
                         package optdepends and 'man control-ofc-daemon').
     * Gigabyte / ASUS:  may need 'acpi_enforce_resources=lax' on the kernel
                         command line for the Super I/O chip to bind.
     * AMD RDNA3+ GPU:   PMFW fan curves need 'amdgpu.ppfeaturemask=0xffffffff'
                         on the kernel command line.
   The GUI's Hardware page (readiness + Super-I/O detection) detects each of
   these and shows the exact driver + fix for your machine.

   Advanced (optional): an OPT-IN active Super-I/O port probe can identify an
   unbound chip whose driver you don't yet know. It is OFF by default and needs
   CAP_SYS_RAWIO (~root-equivalent) — do not enable it unless you need it. See
   /usr/share/doc/control-ofc-daemon/superio-port-probe.conf.example.

   Advanced (optional): read-only NVIDIA telemetry via NVML is OFF by default
   and EXPERIMENTAL (unverified on hardware). To try it, set
   [detection] enable_nvidia_telemetry = true and copy the opt-in drop-in from
   /usr/share/doc/control-ofc-daemon/nvidia-telemetry.conf.example to
   /etc/systemd/system/control-ofc-daemon.service.d/nvidia-telemetry.conf (that
   file lists the exact command). The open nouveau driver needs neither — its
   GPU is read via hwmon automatically.
EOF
}

post_upgrade() {
    echo ":: Restart to apply changes:"
    echo "   sudo systemctl restart control-ofc-daemon"
    # DEC-387: the first upgrade onto the systemd watchdog. pacman reloads systemd
    # at the END of the transaction, after this runs; from then on the new unit's
    # WatchdogSec applies to the daemon that is ALREADY running, and that daemon
    # predates it and sends no keep-alives — so systemd times it out and restarts
    # it onto this version (gracefully: the watchdog sends SIGTERM, DEC-388).
    # Detected by what systemd has loaded right now (a watchdog of 0), not by a
    # version compare, so it fires exactly once whatever version the upgrade
    # comes from. Said here so a one-off "Watchdog timeout" in the journal is not
    # read as a crash.
    if systemctl is-active --quiet control-ofc-daemon.service 2>/dev/null &&
       [[ "$(systemctl show -p WatchdogUSec --value control-ofc-daemon.service 2>/dev/null)" == 0 ]]; then
        echo ":: This version adds a systemd watchdog. When pacman reloads systemd at the"
        echo "   end of this upgrade, the running daemon (which predates it) is stopped and"
        echo "   restarted onto the new version automatically; the journal shows one"
        echo "   'Watchdog timeout' for the old process. That is expected, and happens"
        echo "   only on this upgrade."
    fi
    # The tray is a session process, not a systemd system service: an upgrade
    # replaces the binary on disk but the running one keeps going until the
    # user logs out. Say so, rather than leaving them wondering why a fixed bug
    # is still present.
    if [[ -x /usr/bin/control-ofc-tray ]] && pgrep -x control-ofc-tray >/dev/null 2>&1; then
        echo ":: A control-ofc-tray is running from the previous version. It will pick up"
        echo "   this one at your next login, or immediately with:"
        echo "   systemctl --user restart 'app-control\\x2dofc\\x2dtray@autostart.service'"
    fi
    if [[ -f /etc/systemd/system/control-ofc-daemon.service.d/superio-port-probe.conf ]]; then
        echo ":: Opt-in Super-I/O port-probe drop-in detected — review it against the"
        echo "   updated example in case the required directives changed:"
        echo "   /usr/share/doc/control-ofc-daemon/superio-port-probe.conf.example"
    fi
    if [[ -f /etc/systemd/system/control-ofc-daemon.service.d/nvidia-telemetry.conf ]]; then
        echo ":: Opt-in NVIDIA telemetry drop-in detected — review it against the"
        echo "   updated example in case the required directives changed:"
        echo "   /usr/share/doc/control-ofc-daemon/nvidia-telemetry.conf.example"
    fi
    # Only speak up on a board that is actually affected, and only when the
    # symptom is present -- a Super-I/O chip the DMI table expects is missing.
    # The guard shipped by this version PREVENTS the latch on the next boot; it
    # does NOT clear one already set, and nothing short of removing mains power
    # does. Without this the user restarts the daemon as told, sees no change,
    # and has no pointer to the recovery except a journal line they may not read.
    if [[ -r /sys/class/dmi/id/board_vendor ]] &&
       grep -qi gigabyte /sys/class/dmi/id/board_vendor 2>/dev/null &&
       [[ $(ls -d /sys/class/hwmon/hwmon*/ 2>/dev/null |
            xargs -r -I{} cat {}name 2>/dev/null |
            grep -c '^it8') -eq 1 ]]; then
        echo ":: This version adds a guard that stops nct6775/w83627ehf hiding a second"
        echo "   Super-I/O chip on Gigabyte ITE boards. Only one ITE chip is visible here."
        echo "   If fan headers are missing, check: sudo dmesg | grep it87"
        echo "   A line reading 'Unsupported chip (DEVID=0x8883)' means a bridge is latched."
        echo "   The guard prevents it recurring but CANNOT clear it — that needs a full"
        echo "   power cut (PSU switch or unplug); a reboot will not work. Full steps:"
        echo "   https://github.com/Plan-B-Development/control-ofc-gui/blob/main/manual/hardware-troubleshooting.md"
    fi
}

pre_remove() {
    if systemctl is-active --quiet control-ofc-daemon.service; then
        systemctl stop control-ofc-daemon.service
    fi
    if systemctl is-enabled --quiet control-ofc-daemon.service; then
        systemctl disable control-ofc-daemon.service
    fi
}

post_remove() {
    echo ":: Configuration preserved in /etc/control-ofc/"
    echo "   Remove manually if no longer needed."
    echo ":: State data preserved in /var/lib/control-ofc/"
    echo "   Remove manually if no longer needed."
    if [[ -f /etc/systemd/system/control-ofc-daemon.service.d/superio-port-probe.conf ]]; then
        echo ":: Opt-in Super-I/O port-probe drop-in left in place:"
        echo "   /etc/systemd/system/control-ofc-daemon.service.d/superio-port-probe.conf"
        echo "   Remove it manually (it was installed by hand, not by the package)."
    fi
    if [[ -f /etc/systemd/system/control-ofc-daemon.service.d/nvidia-telemetry.conf ]]; then
        echo ":: Opt-in NVIDIA telemetry drop-in left in place:"
        echo "   /etc/systemd/system/control-ofc-daemon.service.d/nvidia-telemetry.conf"
        echo "   Remove it manually (it was installed by hand, not by the package)."
    fi
}
