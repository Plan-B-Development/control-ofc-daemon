[Unit]
Description=Control-OFC Fan Control Daemon
After=local-fs.target
# Ensure cdc_acm is loaded before we start so that DeviceAllow=char-ttyACM
# can resolve the device group from /proc/devices. Without this, starting
# before cdc_acm loads (common on boot, before USB enumeration) leaves the
# cgroup filter without a ttyACM rule, and the daemon gets EPERM when the
# OpenFanController appears shortly after. See systemd.resource-control(5).
Wants=modprobe@cdc_acm.service
After=modprobe@cdc_acm.service

# Cap restart storms: at most 5 starts per 60 s window (works with Restart=on-failure
# below). These are [Unit]-section directives since systemd v230.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/control-ofc-daemon
ExecStopPost=/usr/bin/control-ofc-restore-auto
ExecReload=/bin/kill -HUP $MAINPID
RuntimeDirectory=control-ofc
# 0755 (systemd's default, pinned explicitly) so a non-root GUI can traverse
# /run/control-ofc to reach the 0666 socket the daemon chmods after bind
# (DEC-049); a future UMask/hardening change then can't silently lock the GUI out.
RuntimeDirectoryMode=0755
StateDirectory=control-ofc
# Socket: /run/control-ofc/control-ofc.sock (created by daemon)
# State: /var/lib/control-ofc/daemon_state.json (active profile pointer)
# Override config: /etc/control-ofc/daemon.toml

# Logging goes to journald by default (env_logger → stderr → journald)
Environment=RUST_LOG=info
# HOME is required for default profile search dirs (~/.config/control-ofc/profiles).
# User=root (below) sets it from the passwd entry, but it is pinned explicitly so
# the resolved path stays obvious and independent of NSS (systemd.exec(5)).
Environment=HOME=/root

# Restart on crash
Restart=on-failure
RestartSec=3

# Defence in depth — NOT the mechanism that bounds shutdown (273-b).
# The daemon bounds most of its own teardown: `shutdown_sequence` allows 3 s per
# task (IPC server + up to three poll/engine tasks) and the runtime teardown adds
# at most RUNTIME_SHUTDOWN_TIMEOUT (2 s). Those parts total ~14 s.
#
# It is NOT a total bound, and this line is what covers the gap. The hardware
# restore itself takes the hwmon controller mutex with no timeout, and the engine
# write path holds that same mutex across a sysfs write inside `spawn_blocking`
# (`backends.rs`), which cannot be cancelled — so a chip that wedges mid-write can
# stall the restore past every timeout above. `shutdown_sequence`'s own doc
# comment has recorded that residual window since DEC-146. Capping systemd's
# patience well below the ~90 s default bounds the stop-job case;
# ExecStopPost=control-ofc-restore-auto then runs. Note what that does and does
# NOT cover: the script restores hwmon `pwm*_enable` and GPU `fan_curve` only.
# OpenFan channels are USB-serial with no firmware-auto to fall back to, so they
# stay latched at the last commanded duty until a daemon owns them again. Fans
# hold, never fall — but this is not a full hand-back and must not be read as one.
# Register row 277-b tracks bounding the restore itself, which is the real fix
# and the only one that also covers the no-stop-job (Restart=on-failure) path.
#
# The number is DERIVED, not picked. An ordinary (non-wedged) stop costs up to
# SHUTDOWN_TASK_TIMEOUT (3 s) per sequential task drain — four of them — plus
# RUNTIME_SHUTDOWN_TIMEOUT (2 s): ~14 s worst case. At 20 s a loaded machine
# whose drains each run near their cap would trip SIGKILL on every routine
# `systemctl restart`, which is not a fault but WOULD make a genuine 277-b wedge
# look routine in the journal. 30 s keeps a real margin over the ordinary path
# while still cutting the wedged case to a third of the default.
#
# The cost, stated so a future reduction is a visible choice rather than a
# rediscovery: in the 277-b wedge this is 10 s LONGER than 20 s before SIGKILL
# lets ExecStopPost run, i.e. 10 s more with the fans latched at whatever duty
# the wedged engine last wrote. They hold rather than fall, and a stop is not a
# thermal event, which is why the trade goes this way — but it is a trade.
# Raise this if the drain budget above ever grows; lower it only against that
# cost, not just for tidiness.
TimeoutStopSec=30

# Privilege model: daemon runs as root, declared explicitly via User=root
# (identical to the prior implicit default — root is what a User=-less system
# service already gets — but it states intent).
User=root
# Group=root pinned explicitly (2026-07-21 audit PKG-3): systemd already
# derives it from root's passwd entry, so this is a no-op today — but it
# states intent and stops a future User= change (or DynamicUser=) from
# silently inheriting an unexpected primary group.
Group=root
# Root is required for direct read/write to /sys/class/hwmon and /sys/class/drm
# sysfs nodes (motherboard fan PWM headers and GPU PMFW fan curves). Serial
# device access (/dev/ttyACM*) is handled via DeviceAllow below.
# CapabilityBoundingSet: drop caps the daemon provably never uses (no netlink/raw-IO,
# no ptrace, no module load, no reboot, no raw USB). CAP_DAC_OVERRIDE is deliberately
# KEPT — sysfs pwm / drm fan_curve / serial-tty writes succeed on owner perms as UID 0,
# but DAC_OVERRIDE is retained as insurance for any board whose sysfs node is not
# root-owned. (Analysis-verified; smoke-test on real hardware before release.)
CapabilityBoundingSet=~CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_PTRACE CAP_SYS_RAWIO CAP_SYS_MODULE CAP_SYS_BOOT

# Security hardening
ProtectHome=read-only
ProtectSystem=strict
# ProtectKernelTunables=true (below) remounts ALL of /sys read-only — ProtectSystem=strict
# alone does NOT (it explicitly exempts /sys) — so this entry is what re-exposes the fan
# nodes for writing. It MUST target /sys/devices, NOT /sys/class/hwmon or /sys/class/drm:
# those class directories hold only symlinks, and sysfs decides writability by the *target*
# inode's mount. Every pwm*/pwm*_enable and GPU fan_curve the daemon writes resolves through
# those symlinks to /sys/devices/... — carving out the class dirs re-exposes the symlinks but
# not their targets, so writes fail with EROFS ("Read-only file system", os error 30). The GPU
# fan_curve lives under .../device/gpu_od/ (a sibling of drm/), also under /sys/devices. Reads
# work fine on the ro mount, so only the write targets need this carve-out. See DEC-199.
# /run/control-ofc and /var/lib/control-ofc are provided by RuntimeDirectory=/StateDirectory=
# above; systemd.exec(5) guarantees those are writable under ProtectSystem=strict.
ReadWritePaths=/sys/devices
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service
SystemCallFilter=~@mount @reboot @swap @debug
SystemCallArchitectures=native

# Extra Protect* isolation (safe set — verified on real hardware).
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
# ProcSubset=pid is deliberately NOT set: it would hide /proc/{modules,ioports,cpuinfo},
# which the live GET /diagnostics/hardware handler reads (hw_diagnostics.rs).

# Owner-only umask for new files and an owner-only StateDirectory.
UMask=0027
StateDirectoryMode=0700

# Network isolation: the daemon's only socket is the filesystem Unix socket at
# /run/control-ofc/control-ofc.sock (unaffected by a private net namespace) and it
# makes no outbound network calls. AF_UNIX is the real socket; AF_NETLINK is kept
# only so a netlink socket libudev may open during available_ports() does not hit
# EAFNOSUPPORT (serial enumeration itself works via static sysfs reads + the
# direct-probe fallback regardless). This still blocks AF_INET/INET6/PACKET.
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK

# Serial device access (OpenFanController)
# Allow all ttyACM and ttyUSB devices (index varies across systems). read+write
# only — the daemon opens existing device nodes and never creates them, so the
# mknod bit (m) is dropped.
DeviceAllow=char-ttyACM rw
DeviceAllow=char-ttyUSB rw
# uucp (Arch/CachyOS) — dialout (Debian/Ubuntu) omitted; systemd fails on missing groups
SupplementaryGroups=uucp

[Install]
WantedBy=multi-user.target
